title buSamAltman — Archive
description A 3rd backup of Sam Altman’s blog for personal training.
permalink index.html
canonicalUrl https://blog.samaltman.com/
buildHtml
head.scroll

main
 id main
 section
  id archive
  addClass archive
  aria-labelledby archive-heading
  div
   addClass archive-intro
   span A 3rd backup of Sam Altman’s blog for personal training.
   span 2013 — 2026
  div
   addClass archive-heading
   div
    h1 All posts
     id archive-heading
     span 121
      addClass count
   div
    addClass archive-controls
    label
     addClass search
     span ⌕
      aria-hidden true
     input
      id search
      type search
      aria-label Filter titles
      placeholder Filter titles…
      autocomplete off
     kbd /
  div
   id search-status
   addClass search-status
   aria-live polite
  section
   addClass year-group
   data-year 2026
   aria-label Writing from 2026
   h3 2026
   div
    addClass year-posts
    a
     addClass post-row
     href 2279512.html
     data-slug 2279512
     time Apr 10
      datetime 2026-04-10
     span -
      addClass post-title
     span 5 min
      addClass read-time
     span ↗
      addClass row-arrow
      aria-hidden true
