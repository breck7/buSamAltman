title buSamAltman — Archive
description this 3rd party backup made by @breckyunits
permalink index.html
canonicalUrl https://blog.samaltman.com/
buildHtml
head.scroll

container 1120px
 id main
 role main
 addClass archive

# All posts
 id archive-heading

label
 addClass search
 input
  id search
  type search
  aria-label Filter titles
  placeholder Filter titles…
  autocomplete off
 kbd /

div
 id search-status
 addClass search-status
 aria-live polite

postsMeta Posts
 orderBy -year -date
  printArchive

div
 id empty
 aria-live polite

clearStack
homeFooter.scroll
site.js
